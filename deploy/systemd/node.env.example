# /etc/hyphen/node.env — operator configuration for hyphen-node.service.
#
# systemd EnvironmentFile syntax: no shell, no `export`, no command
# substitution. `KEY=value`, one per line, `#` starts a comment. Values here
# override the `Environment=` defaults in the unit.

# mainnet | testnet | devnet
HYPHEN_NETWORK=devnet

# Public P2P port; must match the firewall rule you open.
# Network defaults: mainnet 18334, testnet 38334, devnet 48334.
HYPHEN_P2P_PORT=48334

# RPC stays on loopback. Network defaults: mainnet 18333, testnet 38333,
# devnet 48333.
HYPHEN_RPC_PORT=48333

# Comma-separated libp2p multiaddrs, each with an explicit /p2p/<peer-id>;
# a boot node without a peer id is rejected at parse time. Empty is valid on
# devnet/testnet; mainnet refuses to start without at least one.
#
# HYPHEN_BOOT_NODES=/ip4/203.0.113.10/tcp/18334/p2p/12D3KooW...
# HYPHEN_BOOT_NODES=/dns4/seed.example.org/tcp/18334/p2p/12D3KooW...
HYPHEN_BOOT_NODES=

# `info` in production. Raise specific targets while diagnosing, e.g.
# RUST_LOG=info,hyphen_network=debug. Very verbose levels grow the journal
# fast; journald rotation is bounded but disk is not free.
RUST_LOG=info
